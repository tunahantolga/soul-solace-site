---
import BaseLayout from "@/layouts/BaseLayout.astro";
import View from "@/views/AileTerapisi";
import { SITE } from "@/config/site";

const service = {
  "@type": "Service",
  name: "Aile Terapisi ve Aile Danışmanlığı",
  serviceType: "Psikoterapi",
  provider: { "@id": `${SITE.url}/#business` },
  areaServed: SITE.city,
};
---

<BaseLayout title="Aile Terapisi ve Aile Danışmanlığı | İbrahim Sarı" description="Aile içi çatışmaları çözmek ve sağlıklı ilişkiler kurmak için tüm aile üyelerinin ihtiyaçlarına odaklanan aile terapisi. İbrahim Sarı, İstanbul." schema={[service]}>
  <View />
</BaseLayout>
