---
import BaseLayout from "@/layouts/BaseLayout.astro";
import View from "@/views/CiftTerapisi";
import { SITE } from "@/config/site";

const service = {
  "@type": "Service",
  name: "Çift Terapisi ve İlişki Danışmanlığı",
  serviceType: "Psikoterapi",
  provider: { "@id": `${SITE.url}/#business` },
  areaServed: SITE.city,
};
---

<BaseLayout title="Çift Terapisi ve İlişki Danışmanlığı | İbrahim Sarı" description="İletişimi güçlendirmek ve ilişki zorluklarını birlikte aşmak için profesyonel çift terapisi ve ilişki danışmanlığı. İbrahim Sarı, İstanbul." schema={[service]}>
  <View />
</BaseLayout>
