---
import BaseLayout from "@/layouts/BaseLayout.astro";
import View from "@/views/BireyselTerapi";
import { SITE } from "@/config/site";

const service = {
  "@type": "Service",
  name: "Bireysel Psikoterapi",
  serviceType: "Psikoterapi",
  provider: { "@id": `${SITE.url}/#business` },
  areaServed: SITE.city,
};
---

<BaseLayout title="Bireysel Psikoterapi | İbrahim Sarı" description="Kişisel gelişim, duygusal zorluklar ve yaşam problemleri için psikanalitik ve psikodinamik yaklaşımlarla bireysel psikoterapi. İbrahim Sarı, İstanbul." schema={[service]}>
  <View />
</BaseLayout>
