---
import Logo from "@/assets/integratif-logo.svg";
import { NAV, whatsappUrl } from "@/config/site";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
// The "Terapiler" parent is active on any of its child pages.
const isActive = (item: (typeof NAV)[number]) =>
  item.href === pathname || ("children" in item && item.children.some((c) => c.href === pathname));
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-border/70 bg-background/80 backdrop-blur-xl supports-[backdrop-filter]:bg-background/70">
  <div class="container flex h-[4.5rem] items-center gap-6">
    <a href="/" class="shrink-0 text-foreground" aria-label="İntegratif Enstitü ana sayfa">
      <Logo class="h-10 w-auto" aria-hidden="true" />
    </a>

    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Ana menü">
      {
        NAV.map((item) =>
          "children" in item ? (
            <div class="group relative">
              <a
                href={item.href}
                class:list={[
                  "inline-flex items-center gap-1 rounded-full px-4 py-2 text-sm font-medium transition-colors hover:text-foreground",
                  isActive(item) ? "text-foreground" : "text-muted-foreground",
                ]}
              >
                {item.label}
                <svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" />
                </svg>
              </a>
              <div class="invisible absolute left-1/2 top-full w-80 -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul class="card-surface p-2">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={pathname === child.href ? "page" : undefined}
                        class="block rounded-2xl px-4 py-3 transition-colors hover:bg-muted"
                      >
                        <span class="block text-sm font-semibold text-foreground">{child.title}</span>
                        <span class="mt-0.5 block text-xs leading-relaxed text-muted-foreground">{child.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
              class:list={[
                "rounded-full px-4 py-2 text-sm font-medium transition-colors hover:text-foreground",
                isActive(item) ? "text-foreground" : "text-muted-foreground",
              ]}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="btn-primary ml-auto hidden h-10 px-5 sm:inline-flex lg:ml-2">
      Randevu Al
    </a>

    <button
      type="button"
      class="ml-auto inline-flex h-11 w-11 items-center justify-center rounded-full border border-foreground/15 text-foreground sm:ml-0 lg:hidden"
      aria-controls="mobil-menu"
      aria-expanded="false"
      aria-label="Menüyü aç"
      data-menu-toggle
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path data-icon-open d="M4 7h16M4 12h16M4 17h16" />
        <path data-icon-close class="hidden" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <nav id="mobil-menu" class="hidden max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-border/70 bg-background shadow-premium lg:hidden" aria-label="Mobil menü">
    <ul class="container space-y-1 py-4">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
              class="block rounded-2xl px-4 py-3 text-base font-medium text-foreground hover:bg-muted"
            >
              {item.label}
            </a>
            {"children" in item && (
              <ul class="mb-2 ml-4 border-l border-border pl-3">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={pathname === child.href ? "page" : undefined}
                      class="block rounded-xl px-3 py-2 text-sm text-muted-foreground hover:bg-muted hover:text-foreground"
                    >
                      {child.title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
      <li class="pt-3">
        <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="btn-primary w-full">WhatsApp ile Randevu Al</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobil-menu");

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Menüyü kapat" : "Menüyü aç");
    toggle.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
    toggle.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
  };

  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>
