---
import { ArrowUpRight, Brain, Heart, Users } from "lucide-react";
import { THERAPIES } from "@/config/site";

const icons = [Brain, Users, Heart];
---

<section id="hizmetler" class="section">
  <div class="container">
    <div class="reveal grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow">Terapiler</p>
        <h2 class="section-title">Size nasıl yardımcı olabiliriz?</h2>
      </div>
      <p class="section-lead lg:col-span-5">
        Farklı terapi ihtiyaçlarınız için profesyonel ve kişiselleştirilmiş destek. Süreç, ilk görüşmede birlikte
        belirlediğimiz hedefler etrafında şekillenir.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        THERAPIES.map((t, i) => {
          const Icon = icons[i];
          return (
            <a
              href={t.href}
              class="reveal card-surface group relative flex flex-col overflow-hidden p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-glow"
            >
              <span class="font-display text-sm italic text-muted-foreground">0{i + 1}</span>
              <span class="mt-8 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-soft text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
                <Icon className="h-6 w-6" />
              </span>
              <h3 class="mt-6 text-2xl">{t.title}</h3>
              <p class="mt-3 flex-1 leading-relaxed text-muted-foreground">{t.description}</p>
              <span class="mt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
                Detaylı bilgi
                <ArrowUpRight className="h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
