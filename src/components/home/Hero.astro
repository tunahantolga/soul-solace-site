---
import { Picture } from "astro:assets";
import { Award, Brain, Stethoscope, Star, ArrowRight } from "lucide-react";
import portrait from "@/assets/dr-ibrahim-main-optimized.jpg";
import { SITE, whatsappUrl } from "@/config/site";

const credentials = [
  { icon: Stethoscope, label: "İstanbul Üniversitesi Tıp Fakültesi" },
  { icon: Award, label: "TLDP Süpervizörü" },
  { icon: Brain, label: "Nörobilim Doktorası" },
];
---

<section class="relative overflow-hidden pt-28 md:pt-36">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -right-40 -top-40 h-[36rem] w-[36rem] rounded-full bg-primary-soft blur-3xl"></div>
    <div class="absolute -left-32 top-1/3 h-[28rem] w-[28rem] rounded-full bg-sand blur-3xl"></div>
  </div>

  <div class="container grid items-center gap-14 pb-20 md:pb-28 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow">{SITE.name}</p>
      <h1 class="mt-6 text-5xl leading-[1.02] sm:text-6xl lg:text-7xl">
        Psikoterapist<br />
        İbrahim Sarı
      </h1>
      <p class="mt-4 font-display text-2xl italic text-primary sm:text-3xl">{SITE.credentials}</p>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted-foreground">
        Psikanalitik ve psikodinamik temelli, integratif bir yaklaşımla bireysel, çift ve aile terapisi. Güvenli bir
        alanda kendinizi anlamanız ve değişim için yanınızdayız.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="btn-primary h-14 px-8 text-base">
          Randevu Al
          <ArrowRight className="h-4 w-4" />
        </a>
        <a href="#hizmetler" class="btn-ghost h-14 px-8 text-base">Terapileri İnceleyin</a>
      </div>

      <ul class="mt-12 grid gap-4 border-t border-border pt-8 sm:grid-cols-3">
        {
          credentials.map(({ icon: Icon, label }) => (
            <li class="flex items-center gap-3 text-sm font-medium text-foreground">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white shadow-soft">
                <Icon className="h-[1.1rem] w-[1.1rem] text-primary" />
              </span>
              {label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:col-span-5">
      <div class="absolute -inset-4 -z-10 rotate-3 rounded-[2.5rem] bg-primary/10" aria-hidden="true"></div>
      <Picture
        src={portrait}
        formats={["avif", "webp"]}
        widths={[420, 640, 900]}
        sizes="(min-width: 1024px) 28rem, 90vw"
        alt="Psikoterapist İbrahim Sarı"
        class="aspect-[4/5] w-full rounded-[2rem] object-cover object-top shadow-premium"
        loading="eager"
        fetchpriority="high"
      />
      <a
        href="#yorumlar"
        class="card-surface absolute -bottom-6 -left-4 flex items-center gap-3 px-5 py-4 transition-transform hover:-translate-y-0.5 sm:-left-10"
      >
        <span class="flex gap-0.5" aria-hidden="true">
          {[0, 1, 2, 3, 4].map(() => <Star className="h-4 w-4 fill-amber-400 text-amber-400" />)}
        </span>
        <span class="text-sm font-semibold text-foreground">Danışan yorumları</span>
      </a>
    </div>
  </div>
</section>
