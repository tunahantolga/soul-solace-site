---
import { Picture } from "astro:assets";
import { Award, Brain, Mic, Stethoscope, Star, ArrowRight } from "lucide-react";
import photo from "@/assets/ibrahim-sari-konferans.jpg";
import { SITE, whatsappUrl } from "@/config/site";

const credentials = [
  { icon: Stethoscope, label: "İstanbul Üniversitesi Tıp Fakültesi" },
  { icon: Award, label: "TLDP Süpervizörü" },
  { icon: Brain, label: "Nörobilim Doktorası" },
];
---

<section class="relative overflow-hidden pt-28 md:pt-36">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -right-40 -top-40 h-[36rem] w-[36rem] rounded-full bg-primary-soft blur-3xl"></div>
    <div class="absolute -left-32 top-1/3 h-[28rem] w-[28rem] rounded-full bg-sand blur-3xl"></div>
  </div>

  <div class="container grid items-center gap-14 pb-20 md:pb-28 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <p class="eyebrow">{SITE.name}</p>
      <h1 class="mt-6 text-5xl leading-[1.02] sm:text-6xl lg:text-7xl">
        Psikoterapist<br />
        İbrahim Sarı
      </h1>
      <p class="mt-4 font-display text-2xl italic text-primary sm:text-3xl">{SITE.credentials}</p>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted-foreground">
        Psikanalitik ve psikodinamik temelli, integratif bir yaklaşımla bireysel, çift ve aile terapisi. Güvenli bir
        alanda kendinizi anlamanız ve değişim için yanınızdayız.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="btn-primary h-14 px-8 text-base">
          Randevu Al
          <ArrowRight className="h-4 w-4" />
        </a>
        <a href="#hizmetler" class="btn-ghost h-14 px-8 text-base">Terapileri İnceleyin</a>
      </div>

      <ul class="mt-12 grid gap-4 border-t border-border pt-8 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
        {
          credentials.map(({ icon: Icon, label }) => (
            <li class="flex items-center gap-3 text-sm font-medium text-foreground">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white shadow-soft">
                <Icon className="h-[1.1rem] w-[1.1rem] text-primary" />
              </span>
              {label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-xl lg:col-span-6">
      <div class="absolute -inset-3 -z-10 rotate-2 rounded-[2.5rem] bg-primary/10 sm:-inset-4" aria-hidden="true"></div>
      <div class="relative overflow-hidden rounded-[2rem] shadow-premium ring-1 ring-foreground/5">
        <Picture
          src={photo}
          formats={["avif", "webp"]}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 36rem, 92vw"
          alt="İbrahim Sarı bir konferansta konuşma yaparken"
          class="aspect-[6/5] w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-foreground/45 to-transparent" aria-hidden="true"></div>
        <p class="absolute bottom-4 left-5 hidden items-center gap-2 text-sm font-medium text-white sm:inline-flex">
          <Mic className="h-4 w-4" /> Konferans konuşmacısı
        </p>
      </div>
      <div class="card-surface absolute -left-3 -top-5 px-4 py-3 sm:-left-6">
        <p class="font-display text-lg leading-none text-foreground">{SITE.credentials}</p>
        <p class="mt-1 text-xs text-muted-foreground">Psikoterapist</p>
      </div>
      <a
        href="#yorumlar"
        class="card-surface absolute -bottom-6 -right-2 flex items-center gap-3 px-5 py-4 transition-transform hover:-translate-y-0.5 xl:-right-6"
      >
        <span class="flex gap-0.5" aria-hidden="true">
          {[0, 1, 2, 3, 4].map(() => <Star className="h-4 w-4 fill-amber-400 text-amber-400" />)}
        </span>
        <span class="text-sm font-semibold text-foreground">Danışan yorumları</span>
      </a>
    </div>
  </div>
</section>
