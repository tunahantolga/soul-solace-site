---
import { ArrowRight, Award, BookOpen, ExternalLink, FileText, Users } from "lucide-react";
import GalleryTabs from "@/components/GalleryTabs";
import type { GalleryGroup } from "@/lib/types";
import { programFacts } from "@/data/egitim-programi";

interface Props {
  galleries: GalleryGroup[];
}

const { galleries } = Astro.props;

const programs = [
  {
    icon: BookOpen,
    title: "TLDP Süpervizyon",
    description: "Zaman Sınırlı Dinamik Psikoterapi uzman eğitimi. LIFT sertifikalı program.",
    badge: "Uzman Seviye",
  },
  {
    icon: Users,
    title: "İntegratif Psikoterapi",
    description: "Çok yönlü terapi yaklaşımlarını entegre eden master programı.",
    badge: "Master Program",
  },
];
---

<section id="egitim" class="section">
  <div class="container">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="eyebrow">Eğitim & Araştırma</p>
      <h2 class="section-title">Profesyonel gelişim</h2>
      <p class="section-lead">Uluslararası standartlarda süpervizyon ve eğitim programları</p>
    </div>

    <a
      href="/psikodinamik-psikoterapi-egitimi/"
      class="reveal group relative mt-14 block overflow-hidden rounded-[2rem] bg-foreground p-8 text-white shadow-premium sm:p-12"
    >
      <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-primary/50 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <span class="inline-flex rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-white/80">
            Eğitim Programı
          </span>
          <h3 class="mt-6 text-3xl text-white sm:text-4xl">Psikodinamik Psikoterapi Eğitim Programı</h3>
          <p class="mt-4 max-w-xl leading-relaxed text-white/75">
            Gelişimsel nesne ilişkilerinden vaka formülasyonuna uzanan 10 modüllük müfredat ve düzenli grup
            süpervizyonu.
          </p>
          <span class="btn mt-8 bg-white text-foreground group-hover:bg-white/90">
            Programı inceleyin <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
          </span>
        </div>
        <dl class="grid gap-4 sm:grid-cols-2 lg:col-span-5">
          {
            programFacts.slice(0, 4).map((f) => (
              <div class="rounded-2xl bg-white/[0.07] p-4 ring-1 ring-white/10">
                <dt class="text-xs font-semibold uppercase tracking-wider text-white/60">{f.label}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-white/90">{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </a>

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {
        programs.map(({ icon: Icon, title, description, badge }) => (
          <div class="reveal card-surface p-8">
            <div class="flex items-start justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary-soft text-primary">
                <Icon className="h-5 w-5" />
              </span>
              <span class="rounded-full bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">{badge}</span>
            </div>
            <h3 class="mt-6 text-2xl">{title}</h3>
            <p class="mt-2 leading-relaxed text-muted-foreground">{description}</p>
            <p class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-foreground">
              <Award className="h-4 w-4 text-primary" /> Sertifikalı
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-24">
      <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Galeri</p>
          <h3 class="mt-4 text-3xl sm:text-4xl">Eğitimlerden ve seminerlerden kareler</h3>
        </div>
        <p class="max-w-sm text-muted-foreground">Görselleri büyütmek için üzerine dokunun.</p>
      </div>
      <div class="mt-10">
        <GalleryTabs client:visible groups={galleries} />
      </div>
    </div>

    <div class="reveal card-surface mt-12 flex flex-col gap-6 p-8 md:flex-row md:items-center">
      <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-primary-soft text-primary">
        <FileText className="h-6 w-6" />
      </span>
      <div class="flex-1">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">Nörobilim Araştırması</p>
        <h3 class="mt-2 text-xl leading-snug">
          Cognitive effects of dorsolateral versus medial prefrontal anodal transcranial direct current stimulation in
          healthy individuals
        </h3>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row md:flex-col lg:flex-row">
        <a
          href="https://www.tandfonline.com/doi/full/10.1080/13803395.2026.2654020"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          Makaleyi okuyun <ExternalLink className="h-4 w-4" />
        </a>
        <a href="/norobilim-arastirma-posteri.pdf" target="_blank" rel="noopener noreferrer" class="btn-ghost">
          Araştırma posteri (PDF)
        </a>
      </div>
    </div>
  </div>
</section>
