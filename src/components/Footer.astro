---
import Logo from "@/assets/integratif-logo.svg";
import { Calendar, GraduationCap, Mail, MapPin, Phone, ExternalLink } from "lucide-react";
import { SITE, THERAPIES, whatsappUrl } from "@/config/site";

const pages = [
  { href: "/", label: "Ana Sayfa" },
  { href: "/hakkimda", label: "Hakkımda" },
  { href: "/psikodinamik-psikoterapi-egitimi", label: "Eğitim Programı" },
  { href: "/iletisim", label: "İletişim" },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-sand/60">
  <div class="container grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Logo class="h-14 w-auto text-foreground" aria-label="İntegratif Enstitü" />
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-muted-foreground">
        {SITE.person}, {SITE.credentials}. İntegratif psikoterapi yaklaşımıyla profesyonel ve güvenilir ruh sağlığı
        desteği.
      </p>
      <div class="mt-6 flex gap-2">
        <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-foreground/15 text-foreground transition-colors hover:bg-white">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
        </a>
        <a href={SITE.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-foreground/15 text-foreground transition-colors hover:bg-white">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" /><path d="M10 9.5v5l4.5-2.5z" fill="currentColor" /></svg>
        </a>
        <a href={SITE.udemy} target="_blank" rel="noopener noreferrer" aria-label="Udemy eğitimleri" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-foreground/15 text-foreground transition-colors hover:bg-white">
          <GraduationCap className="h-4 w-4" />
        </a>
      </div>
    </div>

    <nav class="lg:col-span-2" aria-label="Sayfalar">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-foreground">Sayfalar</h2>
      <ul class="mt-4 space-y-3 text-sm">
        {pages.map((p) => <li><a href={p.href} class="text-muted-foreground transition-colors hover:text-foreground">{p.label}</a></li>)}
      </ul>
    </nav>

    <nav class="lg:col-span-2" aria-label="Terapiler">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-foreground">Terapiler</h2>
      <ul class="mt-4 space-y-3 text-sm">
        {THERAPIES.map((t) => <li><a href={t.href} class="text-muted-foreground transition-colors hover:text-foreground">{t.title}</a></li>)}
      </ul>
    </nav>

    <div class="lg:col-span-4">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-foreground">İletişim & Randevu</h2>
      <ul class="mt-4 space-y-3 text-sm text-muted-foreground">
        <li>
          <a href={whatsappUrl("Merhaba, iletişime geçmek istiyorum.")} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 hover:text-foreground">
            <Phone className="h-4 w-4 text-primary" />{SITE.phoneDisplay} (WhatsApp)
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-3 break-all hover:text-foreground">
            <Mail className="h-4 w-4 shrink-0 text-primary" />{SITE.email}
          </a>
        </li>
        <li class="inline-flex items-center gap-3"><MapPin className="h-4 w-4 text-primary" />{SITE.city}, Türkiye</li>
      </ul>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href={SITE.doktorTakvimi} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-foreground/15 bg-white/60 px-4 py-2 text-xs font-medium text-foreground hover:bg-white">
          <Calendar className="h-3.5 w-3.5 text-primary" />Doktor Takvimi<ExternalLink className="h-3 w-3 text-muted-foreground" />
        </a>
        <a href={SITE.doktorSitesi} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-foreground/15 bg-white/60 px-4 py-2 text-xs font-medium text-foreground hover:bg-white">
          <Calendar className="h-3.5 w-3.5 text-primary" />Doktor Sitesi<ExternalLink className="h-3 w-3 text-muted-foreground" />
        </a>
      </div>
    </div>
  </div>
  <div class="border-t border-border">
    <p class="container py-6 text-xs text-muted-foreground">© {year} {SITE.person}, {SITE.credentials}. Tüm hakları saklıdır.</p>
  </div>
</footer>
