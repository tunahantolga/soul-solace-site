---
import { ArrowRight, Mail, Phone } from "lucide-react";
import { SITE, whatsappUrl } from "@/config/site";

interface Props {
  title?: string;
  text?: string;
}

const {
  title = "İlk adımı atmaya hazır mısınız?",
  text = "Daha iyi bir yaşam için bugün başlayın. Size özel terapi sürecinizi birlikte planlayalım.",
} = Astro.props;
---

<section class="section pt-0">
  <div class="container">
    <div class="reveal relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-primary to-accent-blue px-6 py-16 text-center text-white shadow-premium sm:px-12 md:py-20">
      <div class="pointer-events-none absolute -left-20 -top-20 h-72 w-72 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-24 -right-16 h-80 w-80 rounded-full bg-foreground/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-3xl text-white sm:text-4xl md:text-5xl">{title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-white/85">{text}</p>
        <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="btn mt-10 h-14 bg-white px-8 text-base text-primary hover:bg-white/90">
          WhatsApp ile randevu alın <ArrowRight className="h-4 w-4" />
        </a>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 text-sm text-white/85 sm:flex-row sm:gap-8">
          <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-white">
            <Phone className="h-4 w-4" />{SITE.phoneDisplay}
          </a>
          <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 break-all hover:text-white">
            <Mail className="h-4 w-4" />{SITE.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
